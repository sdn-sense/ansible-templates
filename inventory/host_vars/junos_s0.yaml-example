template_name: junos.j2
template_name_ping: junos_ping.j2
template_name_traceroute: junos_traceroute.j2
ansible_become: false
ansible_network_os: sense.junos.junos
ansible_ssh_pass: MySuperDuperPassword
ansible_ssh_user: MySuperDuperUsername
hostname: junos_s0
# Per-device template/facts parameters, sourced from the site /etc/ansible-conf.yaml
# `ansparams:` block (written into host_vars by ansible-prepare.py). Not read from
# the SiteRM git (rm-configs) switch config.
# - vlanip: 'vlan' or 'irb' (standard mode only — selects L3 interface type)
# - vlanmode: 'standard' (default), 'mx', or 'ptx'.
#     'mx'  -> routing-instances <ri> bridge-domains VLAN-<id> ...
#     'ptx' -> routing-instances <ri> vlans          VLAN-<id> ...
# - routing_instance: name of the virtual-switch routing-instance. Optional; defaults to
#   SENSE-Vlans when omitted. Only consulted when vlanmode is mx or ptx.
# - subset_config: optional per-subset on/off for getfacts.yaml (junos_facts).
#   Keys: 'default' / 'interfaces' / 'routing'; omitted subsets stay enabled.
#   Set {routing: false} on routers where `show route all | display xml` is slow
#   enough to hit the persistent-CLI timeout and disrupt the other subsets.
ansparams:
  vlanip: 'vlan'
  vlanmode: 'standard'
  # routing_instance: 'SENSE-Vlans'   # optional - uncomment to override the default (mx/ptx only)
  # subset_config: {routing: false}   # optional - skip the routing facts subset on this host
# For snmp monitoring parameters, see Session API parameters: https://easysnmp.readthedocs.io/en/latest/session_api.html
snmp_monitoring:
  hostname: 1.2.3.4
  community: 'community'
  version: 2
